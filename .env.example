# ---------------------------------------------------------------------------
# Canonical production origin. Used for canonical tags, sitemap, robots,
# Open Graph URLs and JSON-LD. No trailing slash.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://potheesh-vignesh-portfolio.vercel.app

# ---------------------------------------------------------------------------
# Contact form delivery (Resend).
# Leave RESEND_API_KEY blank and the form reports delivery as not configured
# and shows the direct-email fallback instead. It never fakes a success.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=kpotheeshvignesh@gmail.com
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (optional spam protection).
# Both keys must be set for the widget + server verification to activate.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Google Analytics 4 (optional). Leave blank to disable analytics entirely.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
